{
  "name": "agent-spillway",
  "version": "0.0.0",
  "description": "Bank coding tasks and drain them through existing agent harnesses with independent verification",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "spillway": "dist/cli.js"
  },
  "files": [
    "dist",
    "plugins",
    ".claude-plugin",
    "schemas",
    "examples",
    "LICENSE",
    "NOTICE",
    "README.md",
    "eval",
    "profiles",
    "scripts/harness-wire-smoke.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "validate:community": "npm run build && node scripts/validate-community.mjs",
    "smoke:onboarding": "node scripts/onboarding-smoke.mjs",
    "smoke:harness": "node scripts/harness-wire-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "@types/picomatch": "^4.0.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/curtiskline/agent-spillway.git"
  }
}
