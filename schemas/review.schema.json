{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "resultSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "verdict": {
      "enum": [
        "accept",
        "needs-repair",
        "reject"
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "enum": [
              "blocking",
              "warning"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Repository-relative POSIX path without traversal, absolute paths, backslashes or controls."
          }
        },
        "required": [
          "severity",
          "message"
        ]
      }
    }
  },
  "required": [
    "resultSha",
    "verdict",
    "findings"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "accept"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "severity": {
                  "const": "warning"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Spillway review report v1",
  "description": "Advice evaluated by the deterministic controller gate; requires exact latest verified SHA and no blocking finding when accepting."
}
